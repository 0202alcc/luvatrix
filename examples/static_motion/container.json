{
  "container_protocol_version": "0.1.0",
  "planes_protocol_version": "0.2.0-dev",
  "app": {
    "id": "examples.static_motion",
    "title": "Static Motion Demo",
    "icon": "assets/icon.svg",
    "web": {
      "tab_title": null,
      "tab_icon": null
    }
  },
  "planes": [
    {
      "id": "home_plane",
      "default_frame": "screen_tl",
      "background": {
        "color": "#0B1020"
      },
      "plane_global_z": 0,
      "position": {
        "x": 0,
        "y": 0,
        "frame": "screen_tl"
      },
      "size": {
        "width": {
          "unit": "px",
          "value": 320
        },
        "height": {
          "unit": "px",
          "value": 180
        }
      }
    },
    {
      "id": "settings_plane",
      "default_frame": "screen_tl",
      "background": {
        "color": "#10251B"
      },
      "plane_global_z": 1,
      "position": {
        "x": 0,
        "y": 0,
        "frame": "screen_tl"
      },
      "size": {
        "width": {
          "unit": "px",
          "value": 320
        },
        "height": {
          "unit": "px",
          "value": 180
        }
      }
    }
  ],
  "routes": [
    {
      "id": "home",
      "default": true,
      "active_planes": [
        "home_plane"
      ],
      "transitions": [
        {
          "trigger": "navigate_settings",
          "to_route": "settings",
          "kind": "fade",
          "duration_ms": 200,
          "easing": "ease_out"
        }
      ]
    },
    {
      "id": "settings",
      "active_planes": [
        "settings_plane"
      ],
      "transitions": [
        {
          "trigger": "navigate_home",
          "to_route": "home",
          "kind": "slide_left",
          "duration_ms": 300,
          "easing": "ease_in_out"
        }
      ]
    }
  ],
  "scripts": [
    {
      "id": "ui",
      "lang": "javascript",
      "src": "scripts/ui.js"
    }
  ],
  "components": [
    {
      "id": "home_title",
      "type": "text",
      "attach_to": "home_plane",
      "component_local_z": 1,
      "blend_mode": "absolute_rgba",
      "position": {
        "x": 10,
        "y": 10,
        "frame": "screen_tl"
      },
      "size": {
        "width": {
          "unit": "px",
          "value": 120
        },
        "height": {
          "unit": "px",
          "value": 24
        }
      },
      "z_index": 1,
      "functions": {
        "on_press_single": "trigger:navigate_settings"
      },
      "props": {
        "text": "Home (click me)",
        "font_size_px": 14,
        "color_hex": "#F5FBFF"
      }
    },
    {
      "id": "home_badge",
      "type": "svg",
      "attach_to": "home_plane",
      "component_local_z": 2,
      "blend_mode": "absolute_rgba",
      "position": {
        "x": 150,
        "y": 12,
        "frame": "screen_tl"
      },
      "size": {
        "width": {
          "unit": "px",
          "value": 32
        },
        "height": {
          "unit": "px",
          "value": 32
        }
      },
      "z_index": 2,
      "props": {
        "svg": "assets/badge.svg"
      }
    },
    {
      "id": "home_hint",
      "type": "text",
      "attach_to": "home_plane",
      "component_local_z": 3,
      "blend_mode": "absolute_rgba",
      "position": {
        "x": 10,
        "y": 150,
        "frame": "screen_tl"
      },
      "size": {
        "width": {
          "unit": "px",
          "value": 300
        },
        "height": {
          "unit": "px",
          "value": 16
        }
      },
      "z_index": 3,
      "props": {
        "text": "No Python. No Pyodide. Just canvas.",
        "font_size_px": 10,
        "color_hex": "#9BC9F8"
      }
    },
    {
      "id": "settings_title",
      "type": "text",
      "attach_to": "settings_plane",
      "component_local_z": 1,
      "blend_mode": "absolute_rgba",
      "position": {
        "x": 10,
        "y": 10,
        "frame": "screen_tl"
      },
      "size": {
        "width": {
          "unit": "px",
          "value": 160
        },
        "height": {
          "unit": "px",
          "value": 24
        }
      },
      "z_index": 1,
      "functions": {
        "on_press_single": "trigger:navigate_home"
      },
      "props": {
        "text": "Settings (click me)",
        "font_size_px": 14,
        "color_hex": "#E8FFE8"
      }
    },
    {
      "id": "js_button",
      "type": "text",
      "attach_to": "home_plane",
      "component_local_z": 4,
      "blend_mode": "absolute_rgba",
      "position": {
        "x": 10,
        "y": 60,
        "frame": "screen_tl"
      },
      "size": {
        "width": {
          "unit": "px",
          "value": 140
        },
        "height": {
          "unit": "px",
          "value": 18
        }
      },
      "z_index": 4,
      "functions": {
        "on_press_single": "ui::go_settings"
      },
      "props": {
        "text": "JS handler: go",
        "font_size_px": 11,
        "color_hex": "#89F0B4"
      }
    }
  ],
  "animations": [
    {
      "target": "settings_title",
      "trigger": "route_enter",
      "kind": "fade",
      "duration_ms": 100,
      "easing": "linear",
      "loop": "none",
      "keyframes": [
        {
          "at": 0.0,
          "props": {
            "opacity": 0.0
          }
        },
        {
          "at": 1.0,
          "props": {
            "opacity": 1.0
          }
        }
      ]
    },
    {
      "target": "home_badge",
      "trigger": "on_mount",
      "kind": "fade",
      "duration_ms": 250,
      "easing": "ease_out",
      "loop": "none",
      "keyframes": [
        {
          "at": 0.0,
          "props": {
            "opacity": 0.0
          }
        },
        {
          "at": 1.0,
          "props": {
            "opacity": 1.0
          }
        }
      ]
    }
  ]
}